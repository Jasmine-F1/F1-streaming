{
  "title": "F1 Mission Control",
  "uid": "f1-mission-control",
  "tags": ["f1-streaming"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "id": 1, "type": "stat", "title": "Active Drivers",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "count(f1_telemetry_speed_kph)", "legendFormat": "drivers", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "#c3c2b7", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "graphMode": "none" }
    },
    {
      "id": 2, "type": "stat", "title": "Records / sec",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(f1_telemetry_records_total[1m]))", "legendFormat": "records/s", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "#c3c2b7", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "graphMode": "area" }
    },
    {
      "id": 3, "type": "stat", "title": "Validation Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * sum(rate(f1_telemetry_invalid_total[5m])) / clamp_min(sum(rate(f1_telemetry_records_total[5m])), 1e-9)", "legendFormat": "invalid %", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#0ca30c", "value": null },
            { "color": "#fab219", "value": 1 },
            { "color": "#d03b3b", "value": 5 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "graphMode": "area" }
    },
    {
      "id": 4, "type": "stat", "title": "Pipeline Lag (p95)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(f1_telemetry_pipeline_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p95 lag", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#0ca30c", "value": null },
            { "color": "#fab219", "value": 1 },
            { "color": "#d03b3b", "value": 10 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "graphMode": "area" }
    },

    { "id": 101, "type": "row", "title": "Live Telemetry", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },

    {
      "id": 10, "type": "timeseries", "title": "Speed (km/h)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "f1_telemetry_speed_kph", "legendFormat": "{{driver_code}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "velocitykmh", "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "HAM" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "LEC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Throttle (%)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "f1_telemetry_throttle_pct", "legendFormat": "{{driver_code}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 110, "custom": { "lineWidth": 2, "fillOpacity": 10, "pointSize": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "HAM" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "LEC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "RPM",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "f1_telemetry_rpm", "legendFormat": "{{driver_code}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 0, "pointSize": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "HAM" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "LEC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13, "type": "timeseries", "title": "Gear",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "f1_telemetry_gear", "legendFormat": "{{driver_code}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 8, "custom": { "lineWidth": 2, "lineInterpolation": "stepAfter", "fillOpacity": 0, "pointSize": 5 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "HAM" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "LEC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 102, "type": "row", "title": "Pipeline Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },

    {
      "id": 20, "type": "timeseries", "title": "Records Processed / sec (by driver)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (driver_code) (rate(f1_telemetry_records_total[1m]))", "legendFormat": "{{driver_code}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "HAM" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "LEC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Invalid Records by Reason",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (reason) (rate(f1_telemetry_invalid_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "speed_out_of_range" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#fab219" } }] },
          { "matcher": { "id": "byName", "options": "rpm_out_of_range" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] },
          { "matcher": { "id": "byName", "options": "throttle_out_of_range" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ec835a" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Out-of-Order Events (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (driver_code) (increase(f1_telemetry_out_of_order_total[5m]))", "legendFormat": "{{driver_code}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "bars" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VER" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "HAM" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "LEC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 103, "type": "row", "title": "Alerts", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 } },

    {
      "id": 30, "type": "table", "title": "Active F1 Alerts",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ALERTS{alertname=~\"F1.*\"}", "format": "table", "instant": true, "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "displayMode": "color-background", "cellOptions": { "type": "color-background" } },
          "mappings": [],
          "thresholds": { "steps": [
            { "color": "#0ca30c", "value": null },
            { "color": "#fab219", "value": 1 }
          ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "alertstate" },
            "properties": [{
              "id": "mappings",
              "value": [
                { "type": "value", "options": { "firing": { "color": "#d03b3b", "index": 0, "text": "FIRING" } } },
                { "type": "value", "options": { "pending": { "color": "#fab219", "index": 1, "text": "PENDING" } } }
              ]
            }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "instance": true, "job": true, "namespace": true, "pod": true, "container": true, "endpoint": true, "service": true, "prometheus": true } } }
      ]
    }
  ]
}
