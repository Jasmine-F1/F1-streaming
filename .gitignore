# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# FastF1 local data cache
.fastf1-cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is intentionally NOT ignored — it should be committed
# so `terraform init` picks the same provider versions everywhere.

# kubeconfig written by the tehcyx/kind Terraform provider (contains cluster
# client certs — same reason kubeconfigs generally aren't committed)
infra/terraform/envs/**/*-config

# Kubernetes / Helm
*.local.yaml
charts/*.tgz

# Logs
*.log

# OS / editor
.DS_Store
.vscode/
.idea/
